<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CodeAlpha - E-Commerce Store</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>🛍️ CodeAlpha Shopping Store</h1>
        <div class="cart-icon">
            🛒 Cart (<span id="cart-count">0</span>)
        </div>
    </header>

    <main class="container">
        <!-- Products Section -->
        <section class="products-section">
            <h2>Our Products</h2>
            <div class="products-grid" id="product-list">
                <!-- Products dynamically js se aayenge -->
            </div>
        </section>

        <!-- Shopping Cart Section -->
        <section class="cart-section">
            <h2>Your Shopping Cart</h2>
            <div id="cart-items">
                <p class="empty-msg">Your cart is empty.</p>
            </div>
            <div class="cart-total">
                <h3>Total Amount: $<span id="total-price">0</span></h3>
                <button class="checkout-btn" onclick="processOrder()">Place Order</button>
            </div>
        </section>
    </main>

    <script src="script.js"></script>
</body>
</html

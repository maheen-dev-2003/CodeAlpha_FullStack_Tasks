
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Fieldwork — Project Management Tool</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/styles.css" />
</head>
<body>

  <!-- ===================== AUTH SCREEN ===================== -->
  <section id="auth-screen" class="auth-screen">
    <div class="auth-panel">
      <div class="brand">
        <span class="brand-mark">⌘</span>
        <span class="brand-name">Fieldwork</span>
      </div>
      <p class="brand-tagline">A quieter way to run projects with a team.</p>

      <div class="auth-tabs">
        <button class="auth-tab active" data-tab="login">Log in</button>
        <button class="auth-tab" data-tab="register">Create account</button>
      </div>

      <form id="login-form" class="auth-form active">
        <label>Email
          <input type="email" id="login-email" required placeholder="you@studio.com" />
        </label>
        <label>Password
          <input type="password" id="login-password" required placeholder="••••••••" />
        </label>
        <button type="submit" class="btn-primary">Log in</button>
        <p class="form-error" id="login-error"></p>
      </form>

      <form id="register-form" class="auth-form">
        <label>Name
          <input type="text" id="register-name" required placeholder="Ada Lovelace" />
        </label>
        <label>Email
          <input type="email" id="register-email" required placeholder="you@studio.com" />
        </label>
        <label>Password
          <input type="password" id="register-password" required placeholder="At least 6 characters" minlength="6" />
        </label>
        <button type="submit" class="btn-primary">Create account</button>
        <p class="form-error" id="register-error"></p>
      </form>
    </div>
  </section>

  <!-- ===================== MAIN APP ===================== -->
  <div id="app" class="app hidden">

    <!-- Sidebar: project list -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <span class="brand-mark">⌘</span>
        <span class="brand-name">Fieldwork</span>
      </div>

      <button id="new-project-btn" class="btn-new-project">+ New project</button>

      <nav id="project-list" class="project-list"></nav>

      <div class="sidebar-footer">
        <div class="current-user">
          <span id="user-avatar" class="avatar"></span>
          <span id="user-name" class="user-name"></span>
        </div>
        <button id="logout-btn" class="btn-ghost">Log out</button>
      </div>
    </aside>

    <!-- Main board area -->
    <main class="board-area">
      <div id="empty-state" class="empty-state">
        <p>Select a project, or create a new one to get started.</p>
      </div>

      <div id="board-view" class="board-view hidden">
        <header class="board-header">
          <div>
            <h1 id="project-name"></h1>
            <p id="project-description" class="project-description"></p>
          </div>
          <div class="board-header-actions">
            <div id="member-avatars" class="member-avatars"></div>
            <button id="invite-btn" class="btn-secondary">Invite</button>
            <button id="add-task-btn" class="btn-primary">+ Add task</button>
          </div>
        </header>

        <div id="columns" class="columns"></div>
      </div>
    </main>
  </div>

  <!-- ===================== MODALS ===================== -->

  <!-- New project modal -->
  <div id="project-modal" class="modal-overlay hidden">
    <div class="modal">
      <h2>New project</h2>
      <form id="project-form">
        <label>Project name
          <input type="text" id="project-name-input" required placeholder="e.g. Website Redesign" />
        </label>
        <label>Description
          <textarea id="project-desc-input" placeholder="What is this project about?"></textarea>
        </label>
        <div class="modal-actions">
          <button type="button" class="btn-ghost" data-close-modal>Cancel</button>
          <button type="submit" class="btn-primary">Create project</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Invite member modal -->
  <div id="invite-modal" class="modal-overlay hidden">
    <div class="modal">
      <h2>Invite a teammate</h2>
      <form id="invite-form">
        <label>Email address
          <input type="email" id="invite-email-input" required placeholder="teammate@studio.com" />
        </label>
        <div class="modal-actions">
          <button type="button" class="btn-ghost" data-close-modal>Cancel</button>
          <button type="submit" class="btn-primary">Send invite</button>
        </div>
      </form>
      <p class="form-error" id="invite-error"></p>
    </div>
  </div>

  <!-- Task detail / create modal -->
  <div id="task-modal" class="modal-overlay hidden">
    <div class="modal modal-wide">
      <form id="task-form">
        <input type="hidden" id="task-id-input" />
        <label>Title
          <input type="text" id="task-title-input" required placeholder="What needs to be done?" />
        </label>
        <label>Description
          <textarea id="task-desc-input" placeholder="Add more detail..."></textarea>
        </label>
        <div class="task-form-row">
          <label>Status
            <select id="task-status-input"></select>
          </label>
          <label>Priority
            <select id="task-priority-input">
              <option value="Low">Low</option>
              <option value="Medium" selected>Medium</option>
              <option value="High">High</option>
            </select>
          </label>
          <label>Assignee
            <select id="task-assignee-input">
              <option value="">Unassigned</option>
            </select>
          </label>
          <label>Due date
            <input type="date" id="task-due-input" />
          </label>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-danger hidden" id="delete-task-btn">Delete task</button>
          <div class="modal-actions-right">
            <button type="button" class="btn-ghost" data-close-modal>Cancel</button>
            <button type="submit" class="btn-primary" id="save-task-btn">Add task</button>
          </div>
        </div>
      </form>

      <div id="comments-section" class="comments-section hidden">
        <h3>Comments</h3>
        <div id="comments-list" class="comments-list"></div>
        <form id="comment-form" class="comment-form">
          <input type="text" id="comment-input" placeholder="Write a comment..." required />
          <button type="submit" class="btn-secondary">Post</button>
        </form>
      </div>
    </div>
  </div>

  <div id="toast" class="toast hidden"></div>

  <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
  <script src="js/api.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
